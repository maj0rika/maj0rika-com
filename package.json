{
  "name": "maj0rika-com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "verify": "node scripts/verify-content.mjs",
    "verify:json": "node scripts/verify-content.mjs --json",
    "verify:strict": "node scripts/verify-content.mjs --strict",
    "verify:test": "node scripts/verify-content.test.mjs",
    "ontology:diff": "node scripts/portfolio-ontology-dry-run.js --dry-run",
    "ontology:diff:redact": "node scripts/portfolio-ontology-dry-run.js --dry-run --redact",
    "ontology:report": "node scripts/portfolio-ontology-dry-run.js --dry-run --out ontology-report.txt",
    "ontology:apply": "node scripts/portfolio-ontology-dry-run.js --apply"
  },
  "dependencies": {
    "framer-motion": "^12.39.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
